# Copy this file to .env.local and fill in the values (see SETUP.md for where each one comes from).
# The store runs without any of these (bundled catalogue + demo checkout); each block switches on a feature.

# ── Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Firebase (customer login: phone OTP, Google, email) — Firebase console → Project settings → Your apps → Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin (server-side token verification) — Project settings → Service accounts → Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private key on ONE line with \n for line breaks, wrapped in double quotes
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Admin panel access: comma-separated emails (must be verified in Firebase — Google sign-in recommended)
ADMIN_EMAILS=brandingdelight@gmail.com

# ── Supabase (products, orders, enquiries, product images) — Project settings → API
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PRODUCT_BUCKET=product-images

# ── Razorpay (UPI, cards incl. American Express, net banking, wallets, EMI) — Dashboard → Account & Settings → API keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Settings → Webhooks (events: payment.captured, payment.failed, order.paid)
RAZORPAY_WEBHOOK_SECRET=
